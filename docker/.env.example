# Copy to docker/.env (not committed) and fill in; docker compose reads it automatically.
# Passwords must not contain single quotes (they are written into SQL by the MySQL init scripts).

# MySQL root password, also used by xxl-job-admin
MYSQL_ROOT_PASSWORD=
# Password of the MySQL account "console" that owns the seatunnel_console database
CONSOLE_DB_PASSWORD=
# Encrypts saved datasource passwords: openssl rand -base64 32
# Keep a copy somewhere safe. Losing it makes every saved datasource password unreadable.
CONSOLE_SECRET_KEY=
# Initial password of the console's "admin" account (min. 8 characters, letters and digits);
# only used on the very first start
CONSOLE_ADMIN_PASSWORD=
# Shared secret between xxl-job-admin and the console executor: any random string
XXL_JOB_ACCESS_TOKEN=

# SeaTunnel Zeta cluster (not part of this stack; see docs/design.md §4.3).
# host.docker.internal is the Docker host, for a cluster started there.
CONSOLE_ZETA_MASTER_URLS=http://host.docker.internal:8080
CONSOLE_ZETA_USERNAME=admin
CONSOLE_ZETA_PASSWORD=

# Ports published on the host
MYSQL_PORT=3306
XXL_JOB_PORT=8081
CONSOLE_PORT=8088

TZ=Asia/Shanghai
