# Runtime environment for seatunnel-console.
# Copy this file to config/console.env and fill in the required values before running bin/console.sh start.

# ---- Required: console's own MySQL database (tables are created by Flyway on first start) ----
CONSOLE_DB_URL=jdbc:mysql://127.0.0.1:3306/seatunnel_console?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
CONSOLE_DB_USERNAME=console
CONSOLE_DB_PASSWORD=

# ---- Required: encryption master key (openssl rand -base64 32) ----
# Keep a backup somewhere safe; losing or changing it makes saved datasource/cluster secrets unreadable.
CONSOLE_SECRET_KEY=

# ---- XXL-JOB (set CONSOLE_XXL_JOB_ENABLED=false to run without scheduler) ----
CONSOLE_XXL_JOB_ENABLED=true
CONSOLE_XXL_JOB_ADMIN_ADDRESSES=http://127.0.0.1:8081
CONSOLE_XXL_JOB_GROUP_ID=
CONSOLE_XXL_JOB_ACCESS_TOKEN=
# CONSOLE_XXL_JOB_EXECUTOR_PORT=9999
# CONSOLE_XXL_JOB_EXECUTOR_ADDRESS=

# ---- First-boot only (safe to remove after initial setup) ----
# CONSOLE_ADMIN_USERNAME=admin
# CONSOLE_ADMIN_PASSWORD=
# CONSOLE_ZETA_MASTER_URLS=http://127.0.0.1:8080
# CONSOLE_ZETA_USERNAME=admin
# CONSOLE_ZETA_PASSWORD=

# ---- Optional JVM & server overrides ----
# JAVA_HOME=/opt/jdk-17
# JAVA_OPTS="-Xms512m -Xmx2g -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"
# CONSOLE_PORT=8088
