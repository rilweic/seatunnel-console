# Local development settings for console-server.
# Copy to dev.env (git-ignored) and fill in, then load it before starting the jar:
#   set -a; source dev.env; set +a
#   java -jar console-server/target/seatunnel-console.jar
# In IntelliJ: Run configuration -> Environment variables -> load from this file.

# ---- console's own MySQL database (tables are created by Flyway on first start) ----
CONSOLE_DB_URL=jdbc:mysql://127.0.0.1:3306/seatunnel_console?serverTimezone=Asia/Shanghai
CONSOLE_DB_USERNAME=console
CONSOLE_DB_PASSWORD=

# Required. Encrypts saved datasource passwords and field-encryption keys: openssl rand -base64 32
# Keep a copy somewhere safe; losing it makes them unreadable.
CONSOLE_SECRET_KEY=

# Initial administrator, created only on the very first start (empty sys_user table).
# Leave the password empty to have one generated and printed once in the log ("initial administrator").
CONSOLE_ADMIN_USERNAME=admin
CONSOLE_ADMIN_PASSWORD=

# Where SeaTunnel job logs are archived
CONSOLE_DATA_DIR=./data
# How often a running job's status and metrics are polled
CONSOLE_RUN_POLL_INTERVAL=2s

# ---- SeaTunnel Zeta cluster (REST API v2, basic auth) ----
CONSOLE_ZETA_MASTER_URLS=http://localhost:8080
CONSOLE_ZETA_USERNAME=admin
CONSOLE_ZETA_PASSWORD=

# ---- XXL-JOB (set CONSOLE_XXL_JOB_ENABLED=false to start without it; scheduling then is unavailable) ----
CONSOLE_XXL_JOB_ENABLED=true
CONSOLE_XXL_JOB_ADMIN_ADDRESSES=http://127.0.0.1:8081
CONSOLE_XXL_JOB_APPNAME=seatunnel-console
# id of the executor group created in xxl-job-admin for AppName seatunnel-console
CONSOLE_XXL_JOB_GROUP_ID=
# the executor group's AccessToken (also set in xxl-job-admin)
CONSOLE_XXL_JOB_ACCESS_TOKEN=
# executor port that xxl-job-admin calls back; set the address when admin cannot reach the detected IP
CONSOLE_XXL_JOB_EXECUTOR_PORT=9999
CONSOLE_XXL_JOB_EXECUTOR_ADDRESS=
